{
  "name": "trendscope",
  "version": "1.0.0",
  "private": true,
  "description": "TrendScope —— 本地优先的跨平台内容趋势与选题决策工作台",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "start": "node dist-server/index.js",
    "demo": "node scripts/demo.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "doctor": "tsx scripts/doctor.mts",
    "verify:release": "tsx scripts/verify-release.mts",
    "check:responsive": "tsx scripts/check-responsive.mts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:backup": "node scripts/db-backup.mjs",
    "smoke:zhihu": "tsx scripts/smoke-zhihu.mts",
    "smoke:embedding": "tsx scripts/smoke-embedding.mts",
    "smoke:studio": "tsx scripts/smoke-studio.mts",
    "eval:topics": "tsx scripts/eval-topics.mjs",
    "eval:scoring": "tsx scripts/eval-scoring.mts",
    "eval:opportunity": "tsx scripts/eval-opportunity.mts",
    "eval:studio": "tsx scripts/eval-studio.mts",
    "desktop:build": "npm run build && tauri build --no-bundle",
    "desktop:dev": "tauri dev"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "better-sqlite3": "~12.10.1",
    "drizzle-orm": "^0.44.2",
    "express": "^4.21.2",
    "lucide-react": "^0.525.0",
    "papaparse": "^5.5.3",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.4",
    "jsdom": "^30.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19 <25"
  }
}
