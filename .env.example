# TrendScope 环境变量示例
# 用法:把本文件复制为项目根目录的 .env,按需填写后重启应用(npm start)。
# 应用启动时会自动读取 .env;已存在的真实环境变量优先,不会被文件覆盖。
#
# 全部三项都是可选的 —— 不填任何一项,TrendScope 依然可以完整使用:
#   · 没有知乎密钥 → 官方采集不可用,导入与本地分析照常
#   · 没有向量密钥 → 使用本地词法基线,话题/相似度照常可算(精度较低,界面会标注)
#   · 没有 AI 密钥 → 选题工作室仍提供确定性证据摘要,只是不生成 AI 方案
# 密钥不会出现在界面、日志或数据库里;设置页只显示"已配置 / 未配置"。

# ---- 知乎官方接口采集(可选)----
ZHIHU_ACCESS_SECRET=

# ---- 语义向量服务(可选;OpenAI 兼容的 /embeddings 协议)----
# 三个键必须同时非空才会启用 API 模式;本地自建服务不需要真密钥,填任意非空占位即可。
# 留空 = 用本地词法基线(功能完整,话题内聚度会低一档)。
# 本机自建 BGE-M3 的启动方式见 docs/HANDOFF.md §6.1。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# ---- AI 选题方案(可选;OpenAI 兼容的 /chat/completions 协议)----
STUDIO_API_KEY=
STUDIO_BASE_URL=
STUDIO_MODEL=

# 没有 STUDIO_API_KEY 时可以复用本机已登录的 AI 命令(裸命令名,例如 claude)
STUDIO_CLI_COMMAND=

# 微博热搜(你自己的登录态;不填则该渠道按渠道跳过,不写任何数据)
WEIBO_COOKIE=

# 热点派生采集:热榜标题 → 站内检索 → 创作内容。填 0 关闭自动派生(手动按钮不受影响)
TRENDSCOPE_HOT_CASCADE=

# ---- 本机边界:共享令牌(可选,留空 = 不启用)----
# 服务本来就只监听 127.0.0.1,并逐条校验 Host / Origin / Referer 是否落在本机回环的同一端口上。
# 设了它,非 GET 请求还必须带一致的 x-agent-token 头 —— 适合"这台机器上还会有别人开浏览器"的情况。
# ⚠ 一旦设置,浏览器界面里的写入(导入、标记、生成方案)也会一并被拒,除非调用方自己带这个头。
#    值只进本机 .env,不会出现在界面、日志或数据库里。
TRENDSCOPE_LOCAL_TOKEN=
